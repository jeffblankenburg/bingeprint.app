# Copy to .env.local and fill in. Never commit real secrets.

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── TV data provider (TMDB) ─────────────────────────────────────────────────
# TMDB v4 "API Read Access Token" from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_API_BASE=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# ─── Analytics: PostHog ──────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Observability: Sentry ───────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── Email: Resend ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Bingeprint <hello@bingeprint.app>"

# ─── Cron ────────────────────────────────────────────────────────────────────
CRON_SECRET=

# ─── Admin (comma-separated emails granted admin) ────────────────────────────
ADMIN_EMAILS=
